<?php

namespace App\Http\Controllers;

use App\Enums\RoleEnum;
use App\Models\Classe;
use App\Models\EmploiDuTemps;
use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Str;

class EmploiDuTempsController extends Controller
{
    private function normalizeRole($role): string
    {
        if ($role instanceof \BackedEnum) {
            return (string) $role->value;
        }

        if (is_object($role) && property_exists($role, 'value')) {
            return (string) $role->value;
        }

        return (string) $role;
    }

    private function normalizeDay(?string $jour): string
    {
        return Str::ucfirst(Str::lower(trim((string) $jour)));
    }

    private function normalizeTime(?string $time): ?string
    {
        if ($time === null || $time === '') {
            return null;
        }

        $time = trim((string) $time);
        if (preg_match('/^(\d{2}):(\d{2})(?::\d{2})?$/', $time, $matches)) {
            return $matches[1] . ':' . $matches[2];
        }

        return $time;
    }

    private function serializeEmploi(EmploiDuTemps $emploi): array
    {
        $emploi->load(['classe', 'enseignant', 'matiere']);

        return [
            'id' => $emploi->id,
            'jour' => $this->normalizeDay($emploi->jour),
            'heure_debut' => $this->normalizeTime($emploi->heure_debut),
            'heure_fin' => $this->normalizeTime($emploi->heure_fin),
            'salle' => $emploi->salle,
            'id_classe' => $emploi->id_classe,
            'id_enseignant' => $emploi->id_enseignant,
            'id_matiere' => $emploi->id_matiere,
            'est_publie' => (bool) $emploi->est_publie,
            'classe' => $emploi->classe,
            'enseignant' => $emploi->enseignant,
            'matiere' => $emploi->matiere,
        ];
    }

    private function enforceAccess(Request $request, ?EmploiDuTemps $emploi = null): bool
    {
        $user = $request->user();
        $role = $this->normalizeRole($user->role);

        if (in_array($role, ['ADMIN', 'SUPER_ADMIN'], true)) {
            return true;
        }

        if ($role === 'ENSEIGNANT') {
            if ($emploi) {
                return (int) $emploi->id_enseignant === (int) $user->id;
            }

            return true;
        }

        if ($role === 'ELEVE') {
            $classeIds = $user->classes()->pluck('classes.id')->map(fn ($id) => (int) $id)->all();
            if ($emploi) {
                return in_array((int) $emploi->id_classe, $classeIds, true);
            }

            return !empty($classeIds);
        }

        return false;
    }

    private function validateScheduleData(array $data, ?int $ignoreId = null): array
    {
        $errors = [];

        if (!empty($data['id_classe'])) {
            $exists = Classe::whereKey($data['id_classe'])->exists();
            if (!$exists) {
                $errors['id_classe'] = ['La classe sélectionnée est invalide.'];
            }
        }

        if (!empty($data['id_enseignant'])) {
            $exists = User::whereKey($data['id_enseignant'])
                ->where('role', RoleEnum::ENSEIGNANT->value)
                ->exists();
            if (!$exists) {
                $errors['id_enseignant'] = ['L\'enseignant sélectionné est invalide.'];
            }
        }

        if (!empty($data['jour']) && !empty($data['heure_debut']) && !empty($data['heure_fin']) && !empty($data['id_classe'])) {
            $jour = $this->normalizeDay($data['jour']);
            $debut = $data['heure_debut'];
            $fin = $data['heure_fin'];

            $query = EmploiDuTemps::where('jour', $jour)
                ->where('id_classe', $data['id_classe'])
                ->when($ignoreId !== null, fn ($query) => $query->where('id', '!=', $ignoreId))
                ->where('heure_debut', '<', $fin)
                ->where('heure_fin', '>', $debut);

            if ($query->exists()) {
                $errors['id_classe'] = ['Cette classe possède déjà un cours sur ce créneau horaire.'];
            }
        }

        return $errors;
    }

    public function index(Request $request)
    {
        $query = EmploiDuTemps::query()->with(['classe', 'enseignant', 'matiere']);

        if ($request->has('id_classe') && $request->input('id_classe') != '') {
            $query->where('id_classe', $request->input('id_classe'));
        }
        if ($request->has('id_enseignant') && $request->input('id_enseignant') != '') {
            $query->where('id_enseignant', $request->input('id_enseignant'));
        }
        if ($request->has('id_matiere') && $request->input('id_matiere') != '') {
            $query->where('id_matiere', $request->input('id_matiere'));
        }
        if ($request->has('jour') && $request->input('jour') != '') {
            $query->where('jour', $this->normalizeDay($request->input('jour')));
        }

        $role = $this->normalizeRole($request->user()->role);
        if ($role === 'ENSEIGNANT') {
            $query->where('id_enseignant', $request->user()->id);
        } elseif ($role === 'ELEVE') {
            $classeIds = $request->user()->classes()->pluck('classes.id')->map(fn ($id) => (int) $id)->all();
            if (!empty($classeIds)) {
                $query->whereIn('id_classe', $classeIds);
            } else {
                $query->whereRaw('0 = 1');
            }
        }

        $emplois = $query->get()->map(fn (EmploiDuTemps $emploi) => $this->serializeEmploi($emploi));

        return response()->json([
            'success' => true,
            'count' => $emplois->count(),
            'data' => $emplois,
        ]);
    }

    public function show(Request $request, $id)
    {
        $emploi = EmploiDuTemps::find($id);
        if (!$emploi) {
            return response()->json(['success' => false, 'message' => 'Séance introuvable.'], 404);
        }

        if (!$this->enforceAccess($request, $emploi)) {
            return response()->json(['success' => false, 'message' => 'Séance introuvable.'], 404);
        }

        return response()->json([
            'success' => true,
            'data' => $this->serializeEmploi($emploi),
        ]);
    }

    public function store(Request $request)
    {
        try {
            $role = $this->normalizeRole($request->user()->role);
            if (!in_array(strtoupper($role), ['ADMIN', 'SUPER_ADMIN'], true)) {
                return response()->json(['success' => false, 'message' => 'Action non autorisée.'], 403);
            }

            $validator = Validator::make($request->all(), [
                'id_classe' => 'required|exists:classes,id',
                'id_enseignant' => 'required',
                'id_matiere' => 'required',
                'jour' => 'required|string',
                'heure_debut' => 'required|regex:/^\d{2}:\d{2}(:\d{2})?$/',
                'heure_fin' => 'required|regex:/^\d{2}:\d{2}(:\d{2})?$/',
                'salle' => 'nullable|string|max:50',
                'est_publie' => 'nullable|boolean',
            ]);

            if ($validator->fails()) {
                return response()->json(['success' => false, 'errors' => $validator->errors()], 422);
            }

            $data = $request->only(['id_classe', 'id_enseignant', 'id_matiere', 'jour', 'heure_debut', 'heure_fin', 'salle']);
            $data['jour'] = $this->normalizeDay($data['jour']);
            $data['est_publie'] = $request->input('est_publie', false);

            if (strlen($data['heure_debut']) === 5) {
                $data['heure_debut'] .= ':00';
            }
            if (strlen($data['heure_fin']) === 5) {
                $data['heure_fin'] .= ':00';
            }

            $errors = $this->validateScheduleData($data);
            if (!empty($errors)) {
                return response()->json(['success' => false, 'errors' => $errors], 422);
            }

            $emploi = EmploiDuTemps::create($data);

            return response()->json([
                'success' => true,
                'message' => 'Séance créée avec succès.',
                'data' => $this->serializeEmploi($emploi),
            ], 201);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Erreur SQL : ' . $e->getMessage(),
            ], 500);
        }
    }

    public function update(Request $request, $id)
    {
        try {
            $role = $this->normalizeRole($request->user()->role);
            if (!in_array(strtoupper($role), ['ADMIN', 'SUPER_ADMIN'], true)) {
                return response()->json(['success' => false, 'message' => 'Action non autorisée.'], 403);
            }

            $emploi = EmploiDuTemps::find($id);
            if (!$emploi) {
                return response()->json(['success' => false, 'message' => 'Séance introuvable.'], 404);
            }

            $validator = Validator::make($request->all(), [
                'id_classe' => 'sometimes|required|exists:classes,id',
                'id_enseignant' => 'sometimes|required',
                'id_matiere' => 'sometimes|required',
                'jour' => 'sometimes|required|string',
                'heure_debut' => 'sometimes|required|regex:/^\d{2}:\d{2}(:\d{2})?$/',
                'heure_fin' => 'sometimes|required|regex:/^\d{2}:\d{2}(:\d{2})?$/',
                'salle' => 'nullable|string|max:50',
                'est_publie' => 'nullable|boolean',
            ]);

            if ($validator->fails()) {
                return response()->json(['success' => false, 'errors' => $validator->errors()], 422);
            }

            $data = $request->only(['id_classe', 'id_enseignant', 'id_matiere', 'jour', 'heure_debut', 'heure_fin', 'salle']);
            if (!empty($data['jour'])) {
                $data['jour'] = $this->normalizeDay($data['jour']);
            }
            if (!empty($data['heure_debut']) && strlen($data['heure_debut']) === 5) {
                $data['heure_debut'] .= ':00';
            }
            if (!empty($data['heure_fin']) && strlen($data['heure_fin']) === 5) {
                $data['heure_fin'] .= ':00';
            }
            if ($request->has('est_publie')) {
                $data['est_publie'] = $request->input('est_publie');
            }

            $errors = $this->validateScheduleData($data, $emploi->id);
            if (!empty($errors)) {
                return response()->json(['success' => false, 'errors' => $errors], 422);
            }

            $emploi->update($data);

            return response()->json([
                'success' => true,
                'message' => 'Séance mise à jour avec succès.',
                'data' => $this->serializeEmploi($emploi->fresh()),
            ]);
        } catch (\Exception $e) {
            return response()->json(['success' => false, 'message' => 'Erreur SQL : ' . $e->getMessage()], 500);
        }
    }

    public function destroy(Request $request, $id)
    {
        $role = $this->normalizeRole($request->user()->role);
        if (!in_array(strtoupper($role), ['ADMIN', 'SUPER_ADMIN'], true)) {
            return response()->json(['success' => false, 'message' => 'Action non autorisée.'], 403);
        }

        $emploi = EmploiDuTemps::find($id);
        if (!$emploi) {
            return response()->json(['success' => false, 'message' => 'Séance introuvable.'], 404);
        }

        $emploi->delete();

        return response()->json([
            'success' => true,
            'message' => 'Séance supprimée avec succès.',
        ]);
    }
}
