import { apiClient } from '../../core/api/apiClient'

export const listClasses = async () => {
  const response = await apiClient('/classes')
  return Array.isArray(response) ? response : (response?.data || [])
}

export const listClasseNiveaux = async () => {
  const response = await apiClient('/classes/niveaux')
  return Array.isArray(response) ? response : (response?.data || [])
}

export const listClasseEleves = async (classeId) => {
  const response = await apiClient(`/mes-classes/${classeId}/eleves`)
  return Array.isArray(response) ? response : (response?.data || [])
}

export const createClasse = (data) =>
  apiClient('/classes', { method: 'POST', data })

export const updateClasse = (id, data) =>
  apiClient(`/classes/${id}`, { method: 'PUT', data })

export const deleteClasse = (id) =>
  apiClient(`/classes/${id}`, { method: 'DELETE' })
